{
  "$comment": "QAスキルセットの品質ゲート。定義元は .github/skills/_shared/hooks.md(どの hook が何を保証するかはそちらの §2)。GitHub Copilot CLI / Copilot cloud agent / VS Code Copilot が読む。Claude Code 用の配線は .claude/settings.json にあり、形式が違うだけで呼ぶスクリプトは同じ。判定は gate_check.py の1本だけが行い、ここは配線のみ。matcher は VS Code では無視されるため実際の絞り込みは hook_entry.py の中で行っている。",
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python .github/skills/_shared/scripts/hook_entry.py session-start",
        "bash": "python3 .github/skills/_shared/scripts/hook_entry.py session-start",
        "linux": "python3 .github/skills/_shared/scripts/hook_entry.py session-start",
        "osx": "python3 .github/skills/_shared/scripts/hook_entry.py session-start",
        "windows": "python .github/skills/_shared/scripts/hook_entry.py session-start"
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "matcher": "bash|powershell",
        "command": "python .github/skills/_shared/scripts/hook_entry.py pre-bash",
        "bash": "python3 .github/skills/_shared/scripts/hook_entry.py pre-bash",
        "linux": "python3 .github/skills/_shared/scripts/hook_entry.py pre-bash",
        "osx": "python3 .github/skills/_shared/scripts/hook_entry.py pre-bash",
        "windows": "python .github/skills/_shared/scripts/hook_entry.py pre-bash"
      },
      {
        "type": "command",
        "matcher": "create|edit",
        "command": "python .github/skills/_shared/scripts/hook_entry.py pre-write",
        "bash": "python3 .github/skills/_shared/scripts/hook_entry.py pre-write",
        "linux": "python3 .github/skills/_shared/scripts/hook_entry.py pre-write",
        "osx": "python3 .github/skills/_shared/scripts/hook_entry.py pre-write",
        "windows": "python .github/skills/_shared/scripts/hook_entry.py pre-write"
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "matcher": "create|edit",
        "command": "python .github/skills/_shared/scripts/hook_entry.py post-write",
        "bash": "python3 .github/skills/_shared/scripts/hook_entry.py post-write",
        "linux": "python3 .github/skills/_shared/scripts/hook_entry.py post-write",
        "osx": "python3 .github/skills/_shared/scripts/hook_entry.py post-write",
        "windows": "python .github/skills/_shared/scripts/hook_entry.py post-write"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python .github/skills/_shared/scripts/hook_entry.py stop",
        "bash": "python3 .github/skills/_shared/scripts/hook_entry.py stop",
        "linux": "python3 .github/skills/_shared/scripts/hook_entry.py stop",
        "osx": "python3 .github/skills/_shared/scripts/hook_entry.py stop",
        "windows": "python .github/skills/_shared/scripts/hook_entry.py stop"
      }
    ],
    "SubagentStop": [
      {
        "type": "command",
        "command": "python .github/skills/_shared/scripts/hook_entry.py subagent-stop",
        "bash": "python3 .github/skills/_shared/scripts/hook_entry.py subagent-stop",
        "linux": "python3 .github/skills/_shared/scripts/hook_entry.py subagent-stop",
        "osx": "python3 .github/skills/_shared/scripts/hook_entry.py subagent-stop",
        "windows": "python .github/skills/_shared/scripts/hook_entry.py subagent-stop"
      }
    ]
  }
}
